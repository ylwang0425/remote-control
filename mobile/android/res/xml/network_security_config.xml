<?xml version="1.0" encoding="utf-8"?>
<!--
  Everything is HTTPS, so cleartext is refused outright and there is no
  debug-overrides block: even a debug build has no way to relax this.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
